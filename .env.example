# Supabase project (Settings -> API). Required for sign-in and cloud sync.
# Without these the app still runs fully in demo mode (data stays in the browser).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Google AI Studio key (https://aistudio.google.com/apikey). Free tier is enough.
# Without it, summaries fall back to the page's own meta description and say so.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Public origin, used for absolute links in exports and the auth redirect.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
